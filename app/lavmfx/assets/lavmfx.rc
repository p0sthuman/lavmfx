// Windows resources for lavmfx.exe (compiled by build.rs with llvm-rc / rc).
// build.rs fills in @VERSION@ ("0.2.3") and @VERSION_COMMAS@ (0,2,3,0) from Cargo.toml.
1 ICON "lavmfx.ico"
1 VERSIONINFO
FILEVERSION @VERSION_COMMAS@
PRODUCTVERSION @VERSION_COMMAS@
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "LAVMFX - Live Audio Visual Mapping FX Mixer"
      VALUE "ProductName", "LAVMFX"
      VALUE "OriginalFilename", "lavmfx.exe"
      VALUE "FileVersion", "@VERSION@"
      VALUE "ProductVersion", "@VERSION@"
      VALUE "LegalCopyright", "Copyright (C) 2026 Kage Bunshin (p0sthuman), GPL-3.0-or-later"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
